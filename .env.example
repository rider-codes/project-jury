# Copy to .env and fill in. Never commit .env.

# Provider: openrouter or gemini (both use an OpenAI-compatible chat endpoint)
JURY_PROVIDER=openrouter

OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional but recommended: raises the GitHub limit from 60 to 5,000 requests an hour.
# A fine-grained token with read-only access to public repos is enough.
GITHUB_TOKEN=

# Model per tier. Pick current model ids from your provider's model list.
# Free OpenRouter models end in ":free".
# List several, comma separated, to fall back when the first is overloaded upstream:
#   JURY_MODEL_CHEAP=model-a:free,model-b:free
JURY_MODEL_CHEAP=
JURY_MODEL_MID=
JURY_MODEL_STRONG=

# Models used when a visitor brings their own key (shown when your free quota runs out).
# Leave a tier empty to use JURY_MODEL_<TIER> above. Put paid models here: a visitor with a free-model
# key still hits that key's own daily cap.
JURY_BYOK_MODEL_CHEAP=
JURY_BYOK_MODEL_MID=
JURY_BYOK_MODEL_STRONG=
JURY_BYOK_MODEL_VISION=

# Per-review budget enforced by llm.py
JURY_MAX_CALLS=60
JURY_MAX_TOKENS=1200000
JURY_MAX_CONCURRENCY=2
